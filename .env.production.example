# docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
POSTGRES_DB=macauth
POSTGRES_USER=macauth
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgresql://macauth:replace-with-a-long-random-db-password@postgres:5432/macauth
SESSION_SECRET=replace-with-a-long-random-session-secret
RADIUS_MAC_FORMAT=colon
APP_PORT=3001

# SAML SSO Settings (Optional)
# Uncomment and configure these to enable SAML Single Sign-On
# SAML_ENTRY_POINT=https://idp.example.com/saml2/idp/SSOService.php
# SAML_ISSUER=mac-address-auth-service
# SAML_CERT=MIIC... (IdP Public Certificate)
